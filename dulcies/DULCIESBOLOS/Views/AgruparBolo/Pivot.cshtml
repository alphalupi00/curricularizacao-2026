@model DULCIESBOLOS.Models.ViewModel.PivotBolosViewModel

@{
    ViewData["Title"] = "Relatório: Vendas por Sabor x Mês";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="mb-1" style="color: #333;">📊 Relatório: Vendas por Sabor x Mês</h2>
        <p class="text-muted mb-0">
            Acompanhamento mensal da quantidade vendida de cada sabor e tamanho de bolo ao longo do tempo.
        </p>
    </div>
    <div>
        <button type="button" class="btn btn-outline-secondary btn-sm px-3" onclick="window.print()">
            🖨️ Imprimir Relatório
        </button>
    </div>
</div>

@* os tres cards *@
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0" style="background-color: #fff0f5; border-left: 4px solid #198754 !important;">
            <div class="card-body py-3">
                <span class="text-muted small">Faturamento Total Acumulado</span>
                <h4 class="mb-0 text-success fw-bold">@Model.ValorGeralTotalFormatado</h4>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0" style="background-color: #fff0f5; border-left: 4px solid #0d6efd !important;">
            <div class="card-body py-3">
                <span class="text-muted small">Total Geral de Bolos Vendidos</span>
                <h4 class="mb-0 text-dark fw-bold">@Model.QuantidadeGeralTotalFormatada</h4>
            </div>
        </div>
    </div>

    <div class="col-md-4">
        <div class="card shadow-sm border-0" style="background-color: #fff0f5; border-left: 4px solid #d63384 !important;">
            <div class="card-body py-3">
                <span class="text-muted small">Variedade no Cardápio</span>
                <h4 class="mb-0 text-dark fw-bold">@Model.Linhas.Count opções</h4>
            </div>
        </div>
    </div>
</div>

@if (!Model.Linhas.Any())
{
    <div class="alert alert-info shadow-sm" role="alert">
        ℹ️ <strong>Nenhum bolo cadastrado:</strong> Cadastre sabores no <a asp-controller="Bolos" asp-action="Create" class="alert-link">Cardápio de Bolos</a> para montar o relatório.
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered mb-0 align-middle">
                    <thead class="table-dark text-center align-middle">
                        <tr>
                            <th class="text-start ps-3" style="min-width: 220px;">Sabor do Bolo</th>
                            <th style="min-width: 90px;">Tamanho</th>
                            <th style="min-width: 110px;">Preço Unit.</th>
                            @foreach (var col in Model.ColunasMeses)
                            {
                                <th style="min-width: 140px;">
                                    @col.NomeMesFormatado
                                </th>
                            }
                            <th class="bg-secondary text-white" style="min-width: 120px;">Total Vendido</th>
                            <th class="bg-success text-white" style="min-width: 130px;">Faturamento (R$)</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var linha in Model.Linhas)
                        {
                            var tamanhoBadge = linha.Tamanho switch
                            {
                                "P" => "bg-info text-dark",
                                "M" => "bg-primary text-white",
                                "G" => "bg-success text-white",
                                _ => "bg-secondary text-white"
                            };

                            <tr>
                                <td class="ps-3 fw-semibold text-start text-capitalize">
                                    @linha.Sabor
                                </td>

                                <td class="text-center">
                                    <span class="badge @tamanhoBadge px-2 py-1">@linha.Tamanho</span>
                                </td>

                                <td class="text-center text-muted">
                                    R$ @linha.PrecoUnitario.ToString("F2")
                                </td>

                                @foreach (var col in Model.ColunasMeses)
                                {
                                    var valor = linha.VendasPorMes.ContainsKey(col.Chave) 
                                        ? linha.VendasPorMes[col.Chave] 
                                        : "-";
                                    var temVenda = valor != "-";

                                    <td class="text-center @(temVenda ? "fw-bold text-dark table-light" : "text-muted")">
                                        @if (temVenda)
                                        {
                                            <span class="badge bg-light text-dark border px-2 py-1">@valor</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                }

                                <!-- Total de unidades vendidas desse sabor -->
                                <td class="text-center fw-bold table-secondary">
                                    @linha.TotalQuantidadeFormatada
                                </td>

                                <!-- Total em R$ desse sabor -->
                                <td class="text-center fw-bold table-success text-success">
                                    @linha.TotalValorFormatado
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>
        </div>
    </div>
}

<style>
    @@media print {
        .menu, .btn, footer {
            display: none !important;
        }
        body {
            background-color: white !important;
        }
        div[style*="margin-left: 250px"] {
            margin-left: 0 !important;
        }
        .container {
            max-width: 100% !important;
            padding: 0 !important;
        }
    }
</style>

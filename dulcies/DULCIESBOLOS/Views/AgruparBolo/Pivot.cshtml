@model DULCIESBOLOS.Models.ViewModel.PivotBolosViewModel

@{
    ViewData["Title"] = "Relatório Pivot de Vendas";
    bool porCliente = Model.TipoAgrupamento == "cliente";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="mb-1" style="color: #333;">📊 Relatório Pivot: Vendas por Sabor</h2>
        <p class="text-muted mb-0">
            Tabela cruzando <strong>@(porCliente ? "Clientes" : "Período / Mês")</strong> nas linhas 
            com os <strong>Sabores de Bolos (Tamanhos P, M, G)</strong> nas colunas.
        </p>
    </div>
    <div class="d-flex gap-2 align-items-center">
        <div class="btn-group" role="group">
            <a asp-action="Pivot" asp-route-tipo="cliente" 
               class="btn @(porCliente ? "btn-dark" : "btn-outline-dark") btn-sm">
                👤 Por Cliente
            </a>
            <a asp-action="Pivot" asp-route-tipo="mes" 
               class="btn @(!porCliente ? "btn-dark" : "btn-outline-dark") btn-sm">
                📅 Por Mês
            </a>
        </div>

        <button type="button" class="btn btn-outline-secondary btn-sm" onclick="window.print()">
            🖨️ Imprimir
        </button>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-0" style="background-color: #fff0f5; border-left: 4px solid #d63384 !important;">
            <div class="card-body py-3">
                <span class="text-muted small">Variedade de Bolos</span>
                <h4 class="mb-0 text-dark fw-bold">@Model.Sabores.Count opções</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0" style="background-color: #fff0f5; border-left: 4px solid #d63384 !important;">
            <div class="card-body py-3">
                <span class="text-muted small">Total Vendido</span>
                <h4 class="mb-0 text-dark fw-bold">@Model.QuantidadeGeralTotalFormatada</h4>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-0" style="background-color: #fff0f5; border-left: 4px solid #198754 !important;">
            <div class="card-body py-3">
                <span class="text-muted small">Faturamento Total</span>
                <h4 class="mb-0 text-success fw-bold">@Model.ValorGeralTotalFormatado</h4>
            </div>
        </div>
    </div>
</div>

@if (!Model.Linhas.Any())
{
    <div class="alert alert-info shadow-sm" role="alert">
        ℹ️ <strong>Nenhuma venda encontrada:</strong> Ainda não há vendas registradas para gerar o agrupamento.
        Cadastre pedidos em <a asp-controller="Vendas" asp-action="Create" class="alert-link">Novo Pedido</a>.
    </div>
}
else
{
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-bordered mb-0 align-middle">
                    <thead class="table-dark text-center align-middle">
                        <tr>
                            <th class="text-start" style="min-width: 180px;">
                                @(porCliente ? "Cliente" : "Período / Mês")
                            </th>
                            <th class="text-start" style="min-width: 140px;">
                                @(porCliente ? "Telefone / E-mail" : "Ano")
                            </th>
                            @foreach (var sabor in Model.Sabores)
                            {
                                <th style="min-width: 120px;">
                                    <div>@sabor.Descricao</div>
                                    <span class="badge bg-secondary fw-normal">Tam. @sabor.Tamanho</span>
                                </th>
                            }
                            <th class="bg-secondary text-white" style="min-width: 110px;">Total (un)</th>
                            <th class="bg-success text-white" style="min-width: 120px;">Total (R$)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var linha in Model.Linhas)
                        {
                            <tr>
                                <td class="fw-semibold text-start">
                                    @linha.Identificador
                                </td>
                                <td class="text-start text-muted small">
                                    @linha.Detalhe
                                </td>
                                @foreach (var sabor in Model.Sabores)
                                {
                                    var valor = linha.ValoresPorSabor.ContainsKey(sabor.Id) 
                                        ? linha.ValoresPorSabor[sabor.Id] 
                                        : "-";
                                    var temVenda = valor != "-";

                                    <td class="text-center @(temVenda ? "fw-bold text-dark table-light" : "text-muted")">
                                        @if (temVenda)
                                        {
                                            <span class="badge bg-light text-dark border">@valor</span>
                                        }
                                        else
                                        {
                                            <span>-</span>
                                        }
                                    </td>
                                }
                                <td class="text-center fw-bold table-secondary">
                                    @linha.TotalQuantidadeFormatada
                                </td>
                                <td class="text-center fw-bold table-success text-success">
                                    @linha.TotalValorFormatado
                                </td>
                            </tr>
                        }
                    </tbody>
                    <tfoot class="table-light border-top border-2 align-middle">
                        <tr class="fw-bold">
                            <td class="text-start" colspan="2">
                                <strong>TOTAL GERAL POR SABOR</strong>
                            </td>
                            @foreach (var sabor in Model.Sabores)
                            {
                                var totalSabor = Model.TotaisPorSabor.ContainsKey(sabor.Id) 
                                    ? Model.TotaisPorSabor[sabor.Id] 
                                    : "-";

                                <td class="text-center table-warning">
                                    <span class="badge bg-warning text-dark border">@totalSabor</span>
                                </td>
                            }
                            <td class="text-center table-secondary text-primary fs-6">
                                @Model.QuantidadeGeralTotalFormatada
                            </td>
                            <td class="text-center table-success text-success fs-6">
                                @Model.ValorGeralTotalFormatado
                            </td>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>
    </div>
}

<style>
    @@media print {
        .menu, .btn, .btn-group, footer {
            display: none !important;
        }
        body {
            background-color: white !important;
        }
        div[style*="margin-left: 250px"] {
            margin-left: 0 !important;
        }
        .container {
            max-width: 100% !important;
            padding: 0 !important;
        }
    }
</style>

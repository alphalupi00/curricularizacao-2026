@model DULCIESBOLOS.Models.Venda

@{
    ViewData["Title"] = "Excluir Pedido";
}

<h1>Excluir</h1>

<h3>Tem certeza de que deseja excluir este pedido?</h3>
<div>
    <h4>Venda</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-3">Cliente</dt>
        <dd class="col-sm-9">@(Model.Usuario?.NomeCompleto ?? "Anônimo")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Bolo)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Bolo.Descricao)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Quantidade)</dt>
        <dd class="col-sm-9">@Html.DisplayFor(model => model.Quantidade)</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Valor)</dt>
        <dd class="col-sm-9">R$ @Model.Valor.ToString("F2")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DataVenda)</dt>
        <dd class="col-sm-9">@Model.DataVenda.ToString("dd/MM/yyyy HH:mm")</dd>

        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
        <dd class="col-sm-9"><span class="badge bg-info text-dark">@Model.Status</span></dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Excluir" class="btn btn-danger" /> |
        <a asp-action="Index">Voltar para a Lista</a>
    </form>
</div>

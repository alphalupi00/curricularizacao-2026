@model DULCIESBOLOS.Models.Venda

@{
    ViewData["Title"] = "Excluir Pedido";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-danger">
                <div class="card-header bg-danger text-white py-3">
                    <h4 class="card-title mb-0"> Confirmar Exclusão de Pedido</h4>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning" role="alert">
                        <strong>Atenção:</strong> Tem certeza de que deseja excluir este pedido de venda?
                    </div>

                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Cliente:</dt>
                        <dd class="col-sm-8 fw-semibold">@(Model.Usuario?.NomeCompleto ?? "Cliente Balcão")</dd>

                        <dt class="col-sm-4 text-muted">Bolo:</dt>
                        <dd class="col-sm-8">@Model.Bolo?.Descricao (Tamanho: @Model.Bolo?.Tamanho)</dd>

                        <dt class="col-sm-4 text-muted">Quantidade:</dt>
                        <dd class="col-sm-8">@Model.Quantidade un</dd>

                        <dt class="col-sm-4 text-muted">Valor:</dt>
                        <dd class="col-sm-8 fw-bold text-success">R$ @Model.Valor.ToString("F2")</dd>

                        <dt class="col-sm-4 text-muted">Data:</dt>
                        <dd class="col-sm-8 text-muted">@Model.DataVenda.ToString("dd/MM/yyyy HH:mm")</dd>
                    </dl>
                </div>
                <div class="card-footer bg-light border-top p-3">
                    <form asp-action="Delete" class="d-flex gap-2">
                        <input type="hidden" asp-for="Id" />
                        <input type="submit" value="Confirmar Exclusão" class="btn btn-danger" />
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar e Voltar</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

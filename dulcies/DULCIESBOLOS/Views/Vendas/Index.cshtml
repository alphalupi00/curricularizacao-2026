@model IEnumerable<DULCIESBOLOS.Models.Venda>

@{
    ViewData["Title"] = "Pedidos e Vendas";
}

<h1>Pedidos e Vendas</h1>

<p>
    <a asp-action="Create" class="btn btn-success">Novo Pedido</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Cliente
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Bolo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Quantidade)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Valor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DataVenda)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Pagamento)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @(item.Usuario?.NomeCompleto ?? "Anônimo")
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Bolo.Descricao)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Quantidade)
            </td>
            <td>
                R$ @item.Valor.ToString("F2")
            </td>
            <td>
                @item.DataVenda.ToString("dd/MM/yyyy HH:mm")
            </td>
            <td>
                <span class="badge bg-info text-dark">@item.Status</span>
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Pagamento.descricao)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Detalhes</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
            </td>
        </tr>
}
    </tbody>
</table>

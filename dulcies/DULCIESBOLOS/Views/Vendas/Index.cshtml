@model IEnumerable<DULCIESBOLOS.Models.Venda>

@{
    ViewData["Title"] = "Pedidos e Vendas";
}

<div class="dulcies-consulta-page">
    <div class="dulcies-consulta-card">
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2 dulcies-consulta-header">
            <div>
                <h2 class="mb-1" style="color: #1f1919;">@(User.IsInRole("Admin") ? " Todos os Pedidos e Vendas" : " Meus Pedidos")</h2>
                <p class="mb-0" style="color: #7c5658;">@(User.IsInRole("Admin") ? "Controle geral de vendas de bolos, status de pedidos e formas de pagamento" : "Acompanhe os seus pedidos de bolo e status de entrega")</p>
            </div>
            <div>
                <a asp-action="Create" class="btn btn-dark">
                    + Novo Pedido
                </a>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table table-hover dulcies-table align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-3">Cliente</th>
                        <th>Bolo / Tamanho</th>
                        <th class="text-center">Qtd</th>
                        <th class="text-center">Total (R$)</th>
                        <th class="text-center">Data do Pedido</th>
                        <th class="text-center">Status</th>
                        <th>Forma de Pagamento</th>
                        <th class="text-end pe-3 text-nowrap">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4" style="color: #7c5658;">
                                Nenhuma venda registrada ainda. Clique em <strong>+ Novo Pedido</strong> para cadastrar.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            var statusBadge = item.Status switch
                            {
                                "Pendente" => "bg-warning text-dark",
                                "Em Produção" => "bg-info text-dark",
                                "Pronto para Entrega" => "bg-primary text-white",
                                "Entregue" => "bg-success text-white",
                                "Cancelado" => "bg-danger text-white",
                                _ => "bg-secondary text-white"
                            };

                            <tr>
                                <td class="ps-3 fw-semibold">
                                    @(item.Usuario?.NomeCompleto ?? "Cliente Balcão")
                                </td>
                                <td>
                                    <div>@item.Bolo?.Descricao</div>
                                    <small style="color: #7c5658;">Tamanho: <span class="badge text-dark border" style="background-color: #fcf3f1; border-color: #000 !important;">@item.Bolo?.Tamanho</span></small>
                                </td>
                                <td class="text-center fw-bold">
                                    @item.Quantidade un
                                </td>
                                <td class="text-center fw-bold" style="color: #1f1919;">
                                    R$ @item.Valor.ToString("F2")
                                </td>
                                <td class="text-center small" style="color: #7c5658;">
                                    @item.DataVenda.ToString("dd/MM/yyyy HH:mm")
                                </td>
                                <td class="text-center">
                                    <span class="badge @statusBadge px-2 py-1">@item.Status</span>
                                </td>
                                <td>
                                    @(item.Pagamento?.descricao ?? "-")
                                </td>
                                <td class="text-end pe-3 text-nowrap">
                                    <div class="d-inline-flex align-items-center gap-1 flex-nowrap">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark text-nowrap">Editar</a>
                                        <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark text-nowrap">Detalhes</a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-dark text-nowrap">Excluir</a>
                                    </div>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
@model DULCIESBOLOS.Models.Venda

@{
    ViewData["Title"] = "Editar Pedido";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-7">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3">
                    <h3 class="card-title mb-0" style="color: #333;">✏️ Editar Pedido #@Model.Id</h3>
                    <small class="text-muted">Atualize as informações, status ou bolo selecionado</small>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="DataVenda" />

                        <!-- Cliente -->
                        <div class="form-group mb-3">
                            <label asp-for="UsuarioId" class="form-label fw-semibold">Cliente</label>
                            <select asp-for="UsuarioId" class="form-select" asp-items="ViewBag.UsuarioId"></select>
                            <span asp-validation-for="UsuarioId" class="text-danger small"></span>
                        </div>

                        <!-- Bolo -->
                        <div class="form-group mb-3">
                            <label asp-for="boloId" class="form-label fw-semibold">Bolo (Sabor e Tamanho)</label>
                            <select asp-for="boloId" class="form-select" asp-items="ViewBag.boloId"></select>
                            <span asp-validation-for="boloId" class="text-danger small"></span>
                        </div>

                        <!-- Quantidade -->
                        <div class="form-group mb-3">
                            <label asp-for="Quantidade" class="form-label fw-semibold">Quantidade</label>
                            <input asp-for="Quantidade" class="form-control" type="number" min="1" max="100" />
                            <span asp-validation-for="Quantidade" class="text-danger small"></span>
                        </div>

                        <!-- Status do Pedido -->
                        <div class="form-group mb-3">
                            <label asp-for="Status" class="form-label fw-semibold">Status do Pedido</label>
                            <select asp-for="Status" class="form-select">
                                <option value="Pendente">Pendente</option>
                                <option value="Em Produção">Em Produção</option>
                                <option value="Pronto para Entrega">Pronto para Entrega</option>
                                <option value="Entregue">Entregue</option>
                                <option value="Cancelado">Cancelado</option>
                            </select>
                            <span asp-validation-for="Status" class="text-danger small"></span>
                        </div>

                        <!-- Forma de Pagamento -->
                        <div class="form-group mb-4">
                            <label asp-for="formaPagamentoId" class="form-label fw-semibold">Forma de Pagamento</label>
                            <select asp-for="formaPagamentoId" class="form-select" asp-items="ViewBag.formaPagamentoId"></select>
                            <span asp-validation-for="formaPagamentoId" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <input type="submit" value="Salvar Alterações" class="btn btn-primary px-4" />
                            <a asp-action="Index" class="btn btn-outline-secondary">Voltar para a Lista</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model DULCIESBOLOS.Models.Acrescimo

@{
    ViewData["Title"] = "Excluir Acréscimo";
}

<h1>Excluir Acréscimo</h1>

<h3>Tem certeza de que deseja excluir este acréscimo?</h3>
<div>
    <h4>Acréscimo</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Descrição
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Descricao)
        </dd>
        <dt class = "col-sm-2">
            Quantidade
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Quantidade)
        </dd>
        <dt class = "col-sm-2">
            Valor (R$)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Valor)
        </dd>
    </dl>
    
    <form asp-action="Delete" class="d-flex gap-2">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Confirmar Exclusão" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar e Voltar</a>
    </form>
</div>

@model IEnumerable<DULCIESBOLOS.Models.Acrescimo>

@{
    ViewData["Title"] = "Index";
}

<h2 class="fw-bold mb-4 text-center" style="color: black;">Acrescimos</h2>

<div class="table-responsive border border-dark rounded shadow-sm p-0 bg-white">
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Descricao)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Quantidade)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Valor)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Descricao)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Quantidade)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Valor)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>


<div class="text-center mt-4">
    <a asp-action="Create" class="btn px-4 py-2 shadow-sm fw-bold" style="background-color: #ffc7f3; border-color: #b6cfeb; color: #333;">
        <i class="bi bi-plus-circle me-1"></i> Adicionar Novo Acrescimo
    </a>
</div>

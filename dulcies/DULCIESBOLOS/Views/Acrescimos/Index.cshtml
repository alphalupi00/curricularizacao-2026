@model IEnumerable<DULCIESBOLOS.Models.Acrescimo>

@{
    ViewData["Title"] = "Acréscimos";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="mb-1" style="color: #333;">✨ Cadastro de Acréscimos</h2>
        <p class="text-muted mb-0">Gerencie as opções de recheios extras, coberturas e adicionais</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-success">
            + Novo Acréscimo
        </a>
    </div>
</div>

<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Descrição</th>
                        <th class="text-center">Quantidade</th>
                        <th class="text-center">Valor Unitário</th>
                        <th class="text-end pe-3">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                Nenhum acréscimo cadastrado ainda. Clique em <strong>+ Novo Acréscimo</strong> para adicionar.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-3 fw-semibold">
                                    @Html.DisplayFor(modelItem => item.Descricao)
                                </td>
                                <td class="text-center text-muted">
                                    @Html.DisplayFor(modelItem => item.Quantidade)
                                </td>
                                <td class="text-center fw-bold text-success">
                                    R$ @item.Valor.ToString("F2")
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">Editar</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@model List<DULCIESBOLOS.Models.ViewModel.AgrupaFormaPag>

@{
    ViewData["Title"] = "Vendas por Forma de Pagamento";
}

<div class="dulcies-consulta-page">
    <div class="dulcies-consulta-card">
        <div class="dulcies-consulta-header">
            <span class="dulcies-consulta-kicker">Dulcies Bolos • Agrupamento</span>
            <h1 class="dulcies-consulta-title"> Total de vendas por Forma de Pagamento</h1>
        </div>

        <div class="table-responsive">
            <table class="table dulcies-table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Forma de Pagamento</th>
                        <th>Nº de Vendas</th>
                        <th>Total Arrecadado</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.FormaPagamento</td>
                            <td>@item.NumeroVendas</td>
                            <td>@item.TotalArrecadado.ToString("C2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
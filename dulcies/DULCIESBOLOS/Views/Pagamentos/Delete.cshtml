@model DULCIESBOLOS.Models.Pagamento

@{
    ViewData["Title"] = "Excluir Forma de Pagamento";
}

<h1>Excluir Forma de Pagamento</h1>

<h3>Tem certeza de que deseja excluir esta forma de pagamento?</h3>
<div>
    <h4>Pagamento</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            Descrição
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.descricao)
        </dd>
    </dl>
    
    <form asp-action="Delete" class="d-flex gap-2">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Confirmar Exclusão" class="btn btn-danger" />
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar e Voltar</a>
    </form>
</div>

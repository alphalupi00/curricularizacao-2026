@model DULCIESBOLOS.Models.Bolo

@{
    ViewData["Title"] = "Cadastrar Novo Bolo";
}

<div class="container py-3">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom py-3">
                    <h3 class="card-title mb-0" style="color: #333;">🎂 Cadastrar Novo Bolo</h3>
                    <small class="text-muted">Preencha o sabor, tamanho (P, M ou G) e o preço de venda</small>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="form-group mb-3">
                            <label asp-for="Descricao" class="form-label fw-semibold">Sabor do Bolo</label>
                            <input asp-for="Descricao" class="form-control" placeholder="Ex: Chocolate Tradicional, Cenoura com Brigadeiro..." />
                            <span asp-validation-for="Descricao" class="text-danger small"></span>
                        </div>

                        <div class="form-group mb-3">
                            <label asp-for="Tamanho" class="form-label fw-semibold">Tamanho (P, M ou G)</label>
                            <select asp-for="Tamanho" class="form-select">
                                <option value="">-- Selecione o Tamanho --</option>
                                <option value="P">P - Pequeno (aprox. 1 kg / 10 a 12 fatias)</option>
                                <option value="M">M - Médio (aprox. 1,5 kg / 15 a 18 fatias)</option>
                                <option value="G">G - Grande (aprox. 2,5 kg / 25 a 30 fatias)</option>
                            </select>
                            <small class="form-text text-muted">Defina o tamanho do bolo entre <strong>P</strong>, <strong>M</strong> ou <strong>G</strong>.</small>
                            <span asp-validation-for="Tamanho" class="text-danger small d-block"></span>
                        </div>

                        <div class="form-group mb-4">
                            <label asp-for="Valor" class="form-label fw-semibold">Valor Unitário (R$)</label>
                            <div class="input-group">
                                <span class="input-group-text">R$</span>
                                <input asp-for="Valor" class="form-control" type="number" step="0.50" min="0.01" placeholder="0,00" />
                            </div>
                            <span asp-validation-for="Valor" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <input type="submit" value="Cadastrar Bolo" class="btn btn-primary px-4" />
                            <a asp-action="Index" class="btn btn-outline-secondary">Voltar para a Lista</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

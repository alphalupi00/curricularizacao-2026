@model IEnumerable<DULCIESBOLOS.Models.Bolo>

@{
    ViewData["Title"] = "Cardápio de Bolos";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="mb-1" style="color: #333;">🎂 Cardápio de Bolos</h2>
        <p class="text-muted mb-0">Gerencie os sabores, tamanhos (P, M, G) e preços cadastrados na Dulcies Bolos</p>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-success">
            + Cadastrar Novo Bolo
        </a>
    </div>
</div>



<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="pesquisa"
       value="@Context.Request.Query["pesquisa"]"
       class="form-control"
       placeholder="Digite o nome ou sabor do bolo..." />

        <button type="submit" class="btn btn-success">
            Pesquisar
        </button>

        <a asp-action="Index" class="btn btn-outline-secondary">
            Limpar
        </a>
    </div>
</form>




<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-3">Sabor</th>
                        <th class="text-center">Tamanho</th>
                        <th class="text-center">Valor Unitário</th>
                        <th class="text-center">Estoque</th>
                        <th class="text-end pe-3">Ações</th>
                    </tr>
                </thead>
                <tbody>

                    @{
                            float totalItemValor = 0; 
                            int totalEstoque = 0;

                     }  @*precisei colocar aqui pois se por fora, ele nao reconhece o item*@



                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="4" class="text-center py-4 text-muted">
                                Nenhum bolo cadastrado no momento. Clique em <strong>+ Cadastrar Novo Bolo</strong> para adicionar.
                            </td>
                        </tr>
                    }
                    else
                    {

                        @foreach (var item in Model)
                        {

                            totalItemValor += item.Valor;
                            totalEstoque += item.Estoque;



                            var tamanhoBadge = item.Tamanho.ToUpper() switch
                            {
                                "P" => "bg-info text-dark",
                                "M" => "bg-primary text-white",
                                "G" => "bg-success text-white",
                                _ => "bg-secondary text-white"
                            };

                            var tamanhoDesc = item.Tamanho.ToUpper() switch
                            {
                                "P" => "Pequeno (P)",
                                "M" => "Médio (M)",
                                "G" => "Grande (G)",
                                _ => item.Tamanho
                            };

                            <tr>
                                <td class="ps-3 fw-semibold">
                                    @Html.DisplayFor(modelItem => item.Descricao)
                                </td>
                                <td class="text-center">
                                    <span class="badge @tamanhoBadge px-2 py-1">@tamanhoDesc</span>
                                </td>
                                <td class="text-center fw-bold text-success">
                                    R$ @item.Valor.ToString("F2")
                                </td>
                                <td class="text-center">
                                    <span class="badge @(item.Estoque > 0 ? "bg-success" : "bg-danger") px-2 py-1">@item.Estoque un</span>
                                </td>
                                <td class="text-end pe-3">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary me-1">Editar</a>
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-outline-info me-1">Detalhes</a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">Excluir</a>
                                </td>
                            </tr>
                        }

                    }
                    
                </tbody>
            </table>

           <h5> Soma de valores: R$ @totalItemValor.ToString("N2")</h5> @* F2 retorna com arredondamento, N2 retorna com separador de milhar e duas casas decimais *@
           <h5>Total de unidades em estoque: @totalEstoque</h5>

        </div>
    </div>
</div>

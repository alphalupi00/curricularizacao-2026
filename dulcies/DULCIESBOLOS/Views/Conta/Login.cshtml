@{
    ViewData["Title"] = "Entrar";
}

<div class="row justify-content-center mt-5 mb-5">
    <div class="col-md-5 col-lg-4">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h2 class="text-center mb-4">Entrar no Sistema</h2>

                <form asp-action="Login" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label for="email" class="form-label">E-mail</label>
                        <input type="email" name="email" id="email" class="form-control" placeholder="exemplo@dominio.com" required />
                    </div>

                    <div class="mb-3">
                        <label for="senha" class="form-label">Senha</label>
                        <input type="password" name="senha" id="senha" class="form-control" placeholder="digite sua senha" required />
                    </div>

                    <div class="mb-3 form-check">
                        <input type="checkbox" name="lembrarMe" id="lembrarMe" value="true" class="form-check-input" />
                        <label for="lembrarMe" class="form-check-label">Lembrar-me</label>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 mb-3">Entrar</button>

                    <div class="text-center mb-3">
                        <span class="text-muted">É um cliente novo? </span>
                        <a asp-action="Registro" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="fw-semibold text-decoration-none">Criar conta</a>
                    </div>
                </form>

                <div class="alert alert-light border mt-3 mb-0 small">
                    <strong class="d-block mb-1">Contas de acesso:</strong>
                    <div>👑 <strong>Admin:</strong> admin@dulciesbolos.com / <code>Admin@123</code></div>
                    <div>👤 <strong>Cliente:</strong> cliente@dulciesbolos.com / <code>Cliente@123</code></div>
                </div>
            </div>
        </div>
    </div>
</div>

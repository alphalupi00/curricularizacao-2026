@model DULCIESBOLOS.Models.ViewModel.RegistroViewModel
@{
    ViewData["Title"] = "Criar Conta de Cliente";
}

<div class="row justify-content-center mt-4 mb-5">
    <div class="col-md-6 col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body p-4">
                <h2 class="text-center mb-3">Cadastro de Cliente</h2>
                <p class="text-muted text-center small mb-4">Crie sua conta de cliente para realizar pedidos na Dulcies Bolos</p>

                <form asp-action="Registro" method="post">
                    <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2" role="alert"></div>

                    <div class="mb-3">
                        <label asp-for="NomeCompleto" class="form-label"></label>
                        <input asp-for="NomeCompleto" class="form-control" placeholder="Seu nome completo" required />
                        <span asp-validation-for="NomeCompleto" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label"></label>
                        <input asp-for="Email" type="email" class="form-control" placeholder="seu@email.com" required />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Telefone" class="form-label"></label>
                            <input asp-for="Telefone" class="form-control" placeholder="(11) 99999-9999" />
                            <span asp-validation-for="Telefone" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label asp-for="Endereco" class="form-label"></label>
                            <input asp-for="Endereco" class="form-control" placeholder="Rua, número, bairro" />
                            <span asp-validation-for="Endereco" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label asp-for="Senha" class="form-label"></label>
                            <input asp-for="Senha" type="password" class="form-control" placeholder="Mínimo 6 caracteres" required />
                            <span asp-validation-for="Senha" class="text-danger small"></span>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label asp-for="ConfirmarSenha" class="form-label"></label>
                            <input asp-for="ConfirmarSenha" type="password" class="form-control" placeholder="Repita a senha" required />
                            <span asp-validation-for="ConfirmarSenha" class="text-danger small"></span>
                        </div>
                    </div>

                    <button type="submit" class="btn btn-primary w-100 py-2 mb-3">Cadastrar e Entrar</button>

                    <div class="text-center">
                        <span class="text-muted">Já tem uma conta? </span>
                        <a asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" class="fw-semibold text-decoration-none">Entrar</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

@model DULCIESBOLOS.Models.Funcionario

@{
    ViewData["Title"] = "Excluir Funcionário";
}

<h1>Excluir</h1>

<h3>Tem certeza de que deseja excluir este funcionário?</h3>
<div>
    <h4>Funcionário</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Nome)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Telefone)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Telefone)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.horarioServico)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.horarioServico)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />
        <input type="submit" value="Excluir" class="btn btn-danger" /> |
        <a asp-action="Index">Voltar para a Lista</a>
    </form>
</div>

@model IEnumerable<DULCIESBOLOS.Models.Funcionario>

@{
    ViewData["Title"] = "Funcionários";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2 class="mb-1" style="color: #333;">👩🧑 Cadastro de Funcionários</h2>
    </div>
    <div>
        <a asp-action="Create" class="btn btn-success">
            + Novo Funcionário
        </a>
    </div>
</div>


<div class="card shadow-sm border-0">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>
                            @Html.DisplayNameFor(model => model.Nome)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.Telefone)
                        </th>
                        <th>
                            @Html.DisplayNameFor(model => model.horarioServico)
                        </th>
                        <th class="text-end pe-3">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @if (!Model.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-4 text-muted">
                                Nenhum Funcionário registrado ainda. Clique em <strong>+ Novo Funcionário</strong> para cadastrar.
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var item in Model) 
                        {
                            <tr>
                                <td class="ps-3 fw-semibold">
                                    @Html.DisplayFor(modelItem => item.Nome)
                                </td>
                                <td >
                                    @Html.DisplayFor(modelItem => item.Telefone)
                                </td>
                                <td >
                                    @Html.DisplayFor(modelItem => item.horarioServico)
                                </td>

                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id">Editar</a> |
                                    <a asp-action="Delete" asp-route-id="@item.Id">Excluir</a>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
            
